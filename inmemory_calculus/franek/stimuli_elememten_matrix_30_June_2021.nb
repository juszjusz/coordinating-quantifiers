Cell[BoxData[{
 RowBox[{
  RowBox[{"fint", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"skd", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
       ",", "x"}], "]"}], 
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"skd", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
       ",", "x"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", 
      RowBox[{"1.2", " ", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
         "maxqD", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
         RowBox[{
         "maxqD", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
        "]"}]}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dint", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Dot", "[", 
    RowBox[{
     RowBox[{
     "discrDistr", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
     ",", 
     RowBox[{
     "discrDistr", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
    "]"}], "*", "0.001"}]}]}], "Input",
