Cell[CellGroupData[{

Cell["Quotient reactive units visualisation -sigma = 0.3", "Subsubsection",
 CellChangeTimes->{{3.783531234547427*^9, 3.783531245024822*^9}, {
  3.837841317222123*^9, 3.837841319764941*^9}, {3.851407022057926*^9, 
