  3.8514084413082857`*^9}},ExpressionUUID->"fd7f5d7f-45ff-4e87-aeb6-\
abef0d43789c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kD", " ", "=", " ", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"100", ",", "0.3"}], "]"}], ",", "50000"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nDs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"n", ",", "0.3"}], "]"}], ",", "50000"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"{", 
        RowBox[{"10", ",", "40", ",", "80"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nkDs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
